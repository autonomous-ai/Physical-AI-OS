# Host-side HAL configuration for the experimental Stack-chan profile.
# Copy to a private local env file and configure identity/token/TLS before use.
HAL_BOARD=host
DEVICE_TYPE=stackchan
HAL_SIMULATE=0

# --- Stack-chan Wi-Fi motion driver ---
# Select `driver: stackchan` for the motion capability in the device ROBOT.md.
# Production requires both TLS files; the ESP32 connects to this HAL listener
# and validates the certificate. Generate a distinct 32+ character token per
# body and provide the same value to its firmware without committing it.
STACKCHAN_BODY_HOST=0.0.0.0
STACKCHAN_BODY_PORT=8765
STACKCHAN_DEVICE_ID=stackchan-01
STACKCHAN_BODY_TOKEN=
STACKCHAN_BODY_TLS_CERT=/etc/autonomous/stackchan-body.crt
STACKCHAN_BODY_TLS_KEY=/etc/autonomous/stackchan-body.key
STACKCHAN_BODY_COMMAND_TIMEOUT=3.0
STACKCHAN_BODY_LEASE_TTL_MS=1500
# Development only, on a trusted isolated network. Keep disabled in production.
STACKCHAN_BODY_ALLOW_INSECURE_WS=0
# Separate saved-home pitch commissioning. Keep off until a supervised bench test.
STACKCHAN_HOME_COMMISSIONING_ENABLED=0

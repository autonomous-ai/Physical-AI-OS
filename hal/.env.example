# HAL Runtime — Environment Variables

# --- Original LeLamp (main.py with LiveKit + OpenAI) ---
OPENAI_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Lamp server.py (FastAPI) ---
# production (default): bind 127.0.0.1, reject non-local requests.
# developer: bind 0.0.0.0, allow all — for local dev/testing only.
#HAL_MODE=production
HAL_SERVO_PORT=/dev/ttyACM0
HAL_DEVICE_ID=hal
HAL_SERVO_FPS=30
HAL_SERVO_HOLD_S=3.0
HAL_HTTP_PORT=5001
HAL_CAMERA_INDEX=0
HAL_CAMERA_WIDTH=640
HAL_CAMERA_HEIGHT=480
# Shared by HAL, os-server, and bootstrap. Allowed: DEBUG, INFO, WARN, ERROR.
#HAL_LOG_LEVEL=INFO
#HAL_LOG_DIR=/var/log/hal
#HAL_DEFAULT_USER=unknown
#HAL_SENSING_ENABLED=true
#HAL_SENSING_INTERVAL=2.0              # Sensing loop poll interval (seconds)
#OS_CONFIG_PATH=/root/config/config.json
# Read by the Go os-server, not by HAL. When the realtime voice agent answers a
# NEW utterance out loud, the main-agent turn still working on the previous
# question loses the speaker and its pending fillers, rather than answering a
# moment later in another voice. Speech only — that turn's servo/LED markers
# still fire, unlike the physical cancel click. Default OFF; set to 1 per body
# to opt in.
#OS_REALTIME_SUPERSEDES_MAIN_REPLY=0
#OPENCLAW_WORKSPACE=/root/.openclaw/workspace

# --- Device profile (which DEVICE.md / SOUL.md this body uses) ---
# DEVICES_DIR: path to the device-profile tree (robots/<type>/{ROBOT.md,SOUL.md}).
#   Shared with the Go os-server. On a flashed image point it at the bundled copy
#   (e.g. /opt/devices); unset in the repo resolves relative to hal.
#DEVICES_DIR=/opt/devices
# DEVICE_TYPE: device class = a folder name under DEVICES_DIR (lamp, intern, …).
#   Picks which DEVICE.md (capability mounting) + SOUL.md (persona) load. Shared
#   with the Go os-server. When unset, falls back to config.json "device_type",
#   then "lamp".
#DEVICE_TYPE=lamp

# --- Audio hardware overrides (leave blank to auto-detect) ---
# Run `arecord -l` / `aplay -l` to find card numbers. Format: plughw:<card>,<device>
#HAL_AUDIO_INPUT_ALSA=plughw:2,0
#HAL_AUDIO_OUTPUT_ALSA=plughw:1,0
#TTS_VOICE=nova                          # alloy, ash, coral, echo, fable, onyx, nova, sage, shimmer
#HAL_TTS_SPEED=1.2                    # 1.0=normal, max 4.0
#HAL_TTS_INSTRUCTIONS=                # Style/vibe prompt, e.g. "Speak warmly like a caring friend"
# Dedicated mic for ambient noise sensing (SoundPerception). Uses sounddevice device index.
# Run: python3 -c "import sounddevice; print(sounddevice.query_devices())" to list devices.
# If unset, falls back to the same device as HAL_AUDIO_INPUT_ALSA.
# Example: 2-mic setup — card 0 (seeed) for sensing, card 1 (USB) for STT
#HAL_AUDIO_SENSING_DEVICE=plughw:1,0
#HAL_AUDIO_OUTPUT_DEVICE=             # sounddevice index override (auto-derived from AUDIO_OUTPUT_ALSA if unset)

# --- Voice activity detection ---
#HAL_VAD_THRESHOLD=500       # RMS threshold; raise if noise triggers false detections
#HAL_SOUND_RMS_THRESHOLD=8000  # RMS threshold for "loud noise" sensing event; raise to reduce false triggers
#HAL_SILENCE_TIMEOUT=2.5     # Seconds of silence before STT session closes
#HAL_SPEECH_HOLDOFF=0.2      # Seconds of speech before STT connects; lower (0.05) for clean mics to avoid losing start of speech

# Secondary VAD filters (run after RMS gate, in order: webrtcvad → Silero)
# Pipeline: RMS → webrtcvad (fast C, ~0.1ms) → Silero ONNX (~20ms) → STT
# Enable both for maximum noise rejection; disable either to reduce CPU or latency.
#HAL_WEBRTCVAD_ENABLED=false           # Enable WebRTC VAD pre-filter (pip install webrtcvad)
#HAL_WEBRTCVAD_AGGRESSIVENESS=2        # 0 (lenient) to 3 (strict)
#HAL_SILERO_ENABLED=true               # Enable Silero ONNX VAD (model bundled in resources/)
#HAL_SILERO_THRESHOLD=0.3             # Speech confidence threshold (0.0–1.0); lower = more sensitive
#HAL_SILERO_CHUNK_SIZE=512            # Samples per Silero inference call
#HAL_WEBRTCVAD_FRAME_MS=30            # Frame size for webrtcvad (10, 20, or 30ms)
#HAL_SESSION_COOLDOWN_S=0.3           # Cooldown between STT sessions
#HAL_STT_KEEPALIVE=false              # Keep Deepgram WS open between sessions (lower latency, higher cost)

# --- Echo cancellation ---
#HAL_ECHO_RMS_FLOOR=200               # RMS must drop below this before re-enabling VAD
#HAL_ECHO_GATE_MAX_WAIT_S=1.5         # Max wait for reverb decay after TTS
#HAL_ECHO_GATE_WINDOW_S=0.05          # RMS check window (50ms)
#HAL_ECHO_SIMILARITY_THRESHOLD=0.55   # Transcript similarity above this = echo, drop it
#HAL_ECHO_RELEVANCE_WINDOW_S=15.0     # Only filter echoes within this window after TTS
#HAL_MAX_SESSION_DURATION_S=30        # Force-close STT session after this (prevent zombies)

# --- Warm mic (keep arecord open during playback) ---
# ON by default, and a prerequisite for the barge-in path below: the warm loop
# drains and discards mic frames while TTS plays, which is where barge-in is
# detected. With this off, the mic is released on TTS and reopened after, and
# barge-in falls back to the legacy monitor.
#HAL_WARM_MIC=true                    # Keep the capture stream open during TTS/music
#HAL_WARM_MIC_ECHO_SKIP_MAX_S=0.1     # Post-playback reverb skip before VAD resumes

# --- Acoustic echo cancellation (WebRTC AEC3) ---
# ON by default. Needs the `aec-audio-processing` binding, which is not a hal
# dependency; without it every AEC entry point is a no-op and the voice path is
# unchanged. Interruption is never decided locally on the cancelled mic: in a
# live session the provider's VAD owns it, otherwise the user taps to interrupt
# (GPIO button, TTP223 touchpad).
# DELAY_MS is per-device and worth measuring: set HAL_AEC_DUMP_DIR, play a
# reply, then cross-correlate aec_mic.wav against aec_ref.wav. On lamp-ee17 the
# real lag was 205ms, not the 150 originally assumed, and it drifts ~667ppm
# because mic and speaker are separate USB devices with independent clocks.
#HAL_AEC_ENABLED=true                 # Master gate; default ON. Needs `uv sync --extra aec`
#HAL_LIVE_DUCK_GAIN=0.12              # Hardware-AEC live only: linear duck gain (0, 1]; restart HAL
#HAL_AEC_DELAY_MS=205                 # Speaker→mic delay hint; per-device, measure it
#HAL_AEC_TAIL_S=2.0                   # Keep cancelling this long after the last speaker write
#HAL_AEC_NS=true                      # APM noise suppression (carries most of the cancellation here)
#HAL_AEC_REF_MS=500                   # Echo-reference FIFO depth; 1500 measured WORSE (3.6 dB vs 23.2)
#HAL_AEC_DUMP_DIR=                    # Set to a dir to write aec_mic/ref/out.wav for offline analysis

# --- Backchannel: active listening cues during STT ---
# Comma-separated filler words. Empty = feature disabled.
#HAL_BACKCHANNEL_FILLERS=Uhm,Ok,Ừ,Hmm
#HAL_BACKCHANNEL_STALL_S=8.0           # Partial unchanged for this long → play cue (high default so cue doesn't bleed into mic during speaker-ID capture; 0 = immediate)
#HAL_BACKCHANNEL_INTERVAL_S=6.0        # Min seconds between cues
#HAL_BACKCHANNEL_VOLUME=0.5            # Volume multiplier (0.0–1.0)

# --- Data layout ---
# Writable state HAL owns. Every default below is the board's own path; each is
# a single env var so an off-device run can move it without a second code path
# (`make sim` sets them all — see docs/simulator.md).
#HAL_POSE_MODEL_PATH=/root/local/models/rtmpose-m.onnx
#HAL_TTS_CACHE_DIR=/var/lib/hal/tts_cache      # Pre-rendered TTS clips
#HAL_CALIBRATION_DIR=/var/lib/hal/calibration/robots/hal_follower  # Servo calibration
#HAL_USER_BEARING_PATH=/var/lib/hal/user_bearing.json  # Last known user direction
#HAL_FACE_HEIGHT_PATH=/var/lib/hal/face_height.json    # Learned face height for gaze
#HAL_BT_STATE_DIR=/var/lib/hal                 # Bluetooth pairing state
#HAL_DL_STALL_LOG=/root/local/dl_ws_stall.log  # Perception WS stall diagnostics
# Default is derived, not fixed: the directory of OS_CONFIG_PATH plus /.volume.
#HAL_VOLUME_STATE_PATH=/root/config/.volume    # Persisted speaker volume

# --- Camera stream ---
#HAL_CAMERA_STREAM_FPS=10             # MJPEG stream frame rate
#HAL_CAMERA_STREAM_WIDTH=320          # Stream resize width
#HAL_CAMERA_STREAM_JPEG_QUALITY=65    # JPEG compression quality (0-100)

# --- Sensing: Event cooldown ---
#HAL_EVENT_COOLDOWN_S=60.0            # Min seconds between events of the same type

# --- Sensing: Sound detection ---
#HAL_SOUND_SAMPLE_DURATION_S=0.5      # Sample window for sound level check

# --- Sensing: Light level detection ---
#HAL_LIGHT_LEVEL_INTERVAL_S=300.0     # Check every N seconds
#HAL_LIGHT_CHANGE_THRESHOLD=50        # Min brightness change (0-255) to trigger event

# --- Sensing: Face detection ---
#HAL_USERS_DIR=/root/local/users
#HAL_STRANGERS_DIR=/root/local/strangers
#HAL_YUNET_CONFIDENCE_THRESHOLD=0.5   # Min confidence for YuNet face detection (lower = catches blur/edge faces)
#HAL_FACE_COOLDOWN_S=10.0             # Min seconds between face presence events
#HAL_FACE_OWNER_FORGET_S=1800.0       # Re-fire presence after N seconds without seeing owner
#HAL_FACE_STRANGER_FORGET_S=1800.0    # Same for strangers (30 min)
#HAL_FACE_STRANGER_FLUSH_S=10.0       # Flush stranger snapshots interval
#HAL_FACE_HEIGHT_RATIO_THRESHOLD=0.10 # Skip faces whose bbox height is under this fraction of frame height (too far / unreliable)

# --- Vision tracking (/servo/track) ---
#HAL_TRACKING_DETECT_LOCAL=true       # Use local YOLOv8n for COCO targets (false → force remote YOLOWorld)
#HAL_TRACKING_FACE_DETECTOR=true      # Use local YuNet for target='face' (false → fall back to remote YOLOWorld)
#HAL_TRACKING_MAX_DURATION_S=10       # Wall-clock auto-stop timeout per tracking session (seconds)

# --- Camera snapshot (/camera/snapshot?save=true) ---
# Default follows AGENT_GATEWAY → the ACTIVE runtime's media root
# (openclaw → /root/.openclaw/media/hal-snapshots, hermes → /root/.hermes/media/hal-snapshots).
# Must stay inside that runtime's allowed media roots (e.g. OpenClaw: `media/`,
# `workspace/`, `canvas/`, `sandboxes/` under its configDir) — outside → image
# tool returns "Local media path is not under an allowed directory" and the agent
# has to cp the file first. Do NOT point this at /tmp (outside the allow-list AND
# wiped on restart). Override only if you know the runtime's allow-list.
#HAL_SNAPSHOT_DIR=/root/.openclaw/media/hal-snapshots

# --- Sensing: Motion detection (remote DL backend) ---
#HAL_MOTION_ENABLED=true
#HAL_MOTION_PER_FACE_ENABLED=false       # per-face action recognition (separate WS session per detected face)
#HAL_MOTION_PER_FACE_DEDUP_WINDOW_S=300  # per-action dedup window per face (5 min)
#HAL_MOTION_PER_FACE_SESSION_TTL_S=30    # evict face WS session after N seconds without seeing that face
#HAL_MOTION_CONFIDENCE_THRESHOLD=0.3
#HAL_MOTION_FLUSH_S=10.0
#HAL_MOTION_EVENT_COOLDOWN_S=360.0
#HAL_MOTION_PERSON_DETECTION_ENABLED=true  # toggle person detection before action recognition (sent to perception-service)
#HAL_MOTION_PERSON_MIN_AREA_RATIO=0.25    # skip persons covering less than 1/4 of frame (sent to perception-service)
#HAL_MOTION_SNAPSHOT_DIR=/tmp/lamp-motion-snapshots
#HAL_MOTION_SNAPSHOT_MAX_COUNT=100

# --- Sensing: Emotion detection (remote DL backend) ---
#HAL_EMOTION_ENABLED=true
#HAL_EMOTION_CONFIDENCE_THRESHOLD=0.5
#HAL_EMOTION_FLUSH_S=10.0
#HAL_EMOTION_SNAPSHOT_DIR=/tmp/lamp-emotion-snapshots
#HAL_EMOTION_SNAPSHOT_MAX_COUNT=100

# --- DL backend connection ---
#DL_BACKEND_URL=                         # Base WS URL, e.g. wss://<pod>-8888.proxy.runpod.net/lelamp
#DL_API_KEY=                             # Shared secret for X-API-Key auth
#DL_MOTION_ENDPOINT=/api/dl/action-analysis/ws    # Appended to DL_BACKEND_URL
#DL_EMOTION_ENDPOINT=/api/dl/emotion-analysis/ws  # Appended to DL_BACKEND_URL
#DL_SPEAKER_ENDPOINT=/api/dl/audio-recognizer/embed  # Appended to DL_BACKEND_URL
#HAL_DL_HEARTBEAT_INTERVAL_S=60.0     # WebSocket heartbeat interval (seconds)

# --- DL backend encryption (RSA + AES-256-GCM) ---
#HAL_DL_ENCRYPTION=false              # Enable client-side encryption for DL backend
#HAL_DL_ENCRYPTION_REQUIRED=false     # Fail if encryption setup fails (no plaintext fallback)
#DL_PUBLIC_KEY_FILE=                     # Path to RSA public key PEM file (if set, skips fetching from LB)
#DL_PUBLIC_KEY_ENDPOINT=/crypto/public-key  # Appended to DL_BACKEND_URL to fetch public key

# --- Sensing: Speaker recognition (voice embedding via perception-service) ---
#HAL_SPEAKER_RECOGNITION_ENABLED=true
#HAL_SPEAKER_MIN_AUDIO_S=0.8          # Min audio duration (seconds) for speaker embedding
# Identity thresholds are RAW cosine in [-1, 1] — same unit the face pipeline
# uses. Renamed from SPEAKER_MATCH_THRESHOLD / SPEAKER_ENROLL_CONSISTENCY_THRESHOLD
# when the unit changed, so an old scaled 0.75 can never be silently reread as
# raw (which would stop matching entirely). Convert: raw = 2 * scaled - 1.
#SPEAKER_MATCH_COS=0.5                   # Match bar: recognition, cluster membership, enroll-time cluster claim, and pairing clips within one enroll batch
#SPEAKER_EMBEDDING_API_TIMEOUT_S=15      # Timeout for embedding API call (seconds)
#HAL_UNKNOWN_AUDIO_DIR=/tmp/lamp-unknown-voice  # Where unknown speaker audio is saved
# Every recognize logs its utterance to this dir's ROOT — on a match too,
# deliberately, so there is always a record of what the device heard. Unknown
# turns are then moved into voice_<N>/ sub-dirs, so despite the dir's name the
# cap below mostly bounds KNOWN-speaker audio. Rolling log: newest N kept,
# oldest evicted. ~32 KB per audio-second, so a 4 s turn is ~128 KB, 100 ≈ 13 MB.
#HAL_MAX_INCOMING_FILES=100                 # Clips kept, oldest evicted first (0 = unbounded)
#HAL_VOICE_STRANGERS_DIR=/root/local/voice_strangers  # Persisted stranger centroid state (embeds/labels/counter .npy)
# ONE identity bar (SPEAKER_MATCH_COS) answers every identity question:
# recognizing an enrolled user, deciding a returning unknown voice belongs to an
# existing cluster, and deciding a cluster's audio belongs to the person being
# enrolled. HAL_CLUSTER_MERGE_THRESHOLD is GONE — it admitted clips at a looser
# bar than the one used to judge the user's own enrollment audio against them.
#HAL_MAX_VOICE_STRANGERS=50                # Cap on tracked stranger CLUSTERS (oldest cluster evicted, dir deleted with it)
# Redundancy, not identity — a different axis, so a different number. Must stay
# ABOVE SPEAKER_MATCH_COS: both measure max cosine to a user's existing samples,
# so a turn joins the extended set only in (SPEAKER_MATCH_COS, SPEAKER_DIVERSITY_COS].
#SPEAKER_DIVERSITY_COS=0.7                 # Above this a turn duplicates a sample we already hold
#SPEAKER_MAX_EXTENDED_SAMPLES=3            # Auto-captured samples kept per user. SAFETY cap: retrieval is max-over-rows, so every extra row lifts every speaker's score
#SPEAKER_MAX_CLUSTER_SAMPLES=3             # Same cap per unknown-voice cluster
# WAVs kept per voice_<N>/ dir, oldest evicted. Distinct from the row cap above:
# every unknown turn's audio is filed there, so without this a recurring stranger's
# dir grows forever (cluster eviction only fires past 50 DISTINCT voices). Also the
# only bound on how many permanent anchor rows one deferred enrollment can add.
#HAL_MAX_CLUSTER_FILES=10                  # 0 = unbounded
#SPEAKER_EXTEND_MIN_DURATION_SEC=2.0       # A turn must be this long to earn an extended slot
#SPEAKER_EXTEND_MIN_MARGIN_COS=0.05        # ...and beat the runner-up speaker by this much
#HAL_ENROLL_NUDGE_COOLDOWN_S=1800          # Per-cluster cooldown for enroll nudge (seconds, default 30 min)

# Speaker recognition debug tracer (SPEAKER-DEBUG block in speaker_recognizer.py).
# OFF by default — dev-only diagnostic; writes input WAV + embeddings + full
# per-chunk score breakdown per recognize/enroll call. Meant to be deleted before
# a final deploy. Read once at startup, so restart HAL after changing.
#HAL_SPEAKER_DEBUG=false                   # true to enable trace output
#HAL_SPEAKER_DEBUG_DIR=                    # Output root (default: speaker_logs/ beside speaker_recognizer.py)
#HAL_SPEAKER_DEBUG_MAX_ENTRIES=1000        # Per-kind dir cap, oldest pruned (0 = unbounded)

# Speech emotion debug tracer (SER-DEBUG block in speech_emotion/debug_tracer.py).
# OFF by default — dev-only diagnostic; writes the submitted + prefiltered WAV,
# the prefilter metrics, the HTTP exchange, the label/confidence verdict and a
# per-stage latency/memory profile for every utterance and every flush/emit.
# Meant to be deleted before a final deploy. Read once at startup, so restart
# HAL after changing.
#HAL_SER_DEBUG=false                       # true to enable trace output
#HAL_SER_DEBUG_DIR=                        # Output root (default: speech_emotion_logs/ beside debug_tracer.py)
#HAL_SER_DEBUG_MAX_ENTRIES=1000            # Per-kind dir cap, oldest pruned (0 = unbounded)

# --- Sensing: Speaker recognition — on-device audio preprocessing ---
# The filter/VAD/normalize pipeline runs on HAL now (not perception). Only audio
# that passes the VAD/quality gate is uploaded; perception is called with
# preprocess=false. Defaults mirror perception's AudioProcessorSetting.
#HAL_SPEAKER_PROC_ENABLE_MONO=true
#HAL_SPEAKER_PROC_ENABLE_RESAMPLE=true
#HAL_SPEAKER_PROC_TARGET_SR=16000
#HAL_SPEAKER_PROC_ENABLE_HIGH_PASS=false   # Butterworth HPF (off by default)
#HAL_SPEAKER_PROC_HIGH_PASS_CUTOFF_HZ=80.0
#HAL_SPEAKER_PROC_ENABLE_NOISE_REDUCE=false  # noisereduce (off by default, lazy import)
#HAL_SPEAKER_PROC_NOISE_STATIONARY=false
#HAL_SPEAKER_PROC_ENABLE_VAD=true          # silero-vad gate (reject non-voice / too-short / low voice-ratio)
#HAL_SPEAKER_PROC_VAD_MIN_DURATION_SEC=0.5
#HAL_SPEAKER_PROC_VAD_MIN_VOICE_RATIO=0.4
#HAL_SPEAKER_PROC_VAD_SPEECH_PROB_THRESHOLD=0.6  # Silero onset prob (offset = -0.15); higher trims more silence (silero default 0.5)
#HAL_SPEAKER_PROC_ENABLE_STOI=true         # SQUIM-STOI intelligibility gate (after VAD, before RMS)
#HAL_SPEAKER_PROC_STOI_MODEL_PATH=/root/local/models/squimm_stoi.onnx  # ~20MB ONNX, downloaded from CDN on first use
#HAL_SPEAKER_PROC_STOI_THRESHOLD=0.70      # Reject clip when mean chunk STOI is below this
#HAL_SPEAKER_PROC_STOI_CHUNK_SEC=5.0       # Chunk length scored, then mean-aggregated (bounds memory)
#HAL_SPEAKER_MODEL_CDN_BASE=https://storage.googleapis.com/autonomous-models  # Weights bucket for the STOI model
#HAL_SPEAKER_PROC_ENABLE_RMS_NORMALIZE=true
#HAL_SPEAKER_PROC_RMS_TARGET=0.1

# --- Sensing: Pose-based motion detection (RTMPose) ---
#HAL_POSE_MOTION_ENABLED=true
#HAL_POSE_MOTION_ANGLE_THRESHOLD=30.0  # Min arm joint angle change (degrees)

# --- Sensing: Snapshot storage ---
#HAL_SNAPSHOT_TMP_DIR=/tmp/lamp-sensing-snapshots
#HAL_SNAPSHOT_TMP_MAX_COUNT=50
#HAL_SNAPSHOT_PERSIST_DIR=/var/lib/hal/snapshots
#HAL_SNAPSHOT_PERSIST_TTL_S=259200     # 72 hours
#HAL_SNAPSHOT_PERSIST_MAX_BYTES=52428800  # 50 MB

# --- Presence: Auto light on/off ---
#HAL_IDLE_TIMEOUT_S=300               # Seconds before dim
#HAL_AWAY_TIMEOUT_S=900               # Seconds before off
#HAL_IDLE_BRIGHTNESS=0.20

# --- Realtime voice agent ---
#HAL_REALTIME_ENABLED=false             # Master gate for the realtime voice pipeline
#HAL_REALTIME_PROVIDER=none             # none | gemini | openai
# Turn detection / VAD: "server_vad" | "semantic_vad" | "off"
# For Gemini: "off" disables automatic activity detection; any other value enables it.
# For OpenAI: maps to turn_detection type in session config.
#HAL_REALTIME_TURN_DETECTION=off

# --- Realtime: Gemini Live ---
#GEMINI_API_KEY=
#HAL_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
#HAL_GEMINI_LIVE_VOICE=Kore             # Puck | Charon | Kore | Fenrir | Aoede
#HAL_GEMINI_THINKING_LEVEL=HIGH         # MINIMAL | LOW | MEDIUM | HIGH
#HAL_GEMINI_USE_LANGUAGE_CODES=false    # Bias input transcription toward stt_language (SDK 2.12 language_hints)

# --- Realtime: OpenAI Realtime ---
#OPENAI_API_KEY=
#HAL_OPENAI_REALTIME_MODEL=gpt-realtime-2
#HAL_OPENAI_REALTIME_VOICE=alloy        # alloy | ash | ballad | coral | echo | sage | shimmer | verse | marin | cedar
#HAL_OPENAI_REASONING_EFFORT=xhigh     # minimal | low | medium | high | xhigh

# --- Realtime: Context manager ---
#HAL_OPENCLAW_WORKSPACE_DIR=/root/.openclaw/workspace
# Codex counterpart — the agent's IDENTITY.md lives here, which is what HAL
# watches to pick up a renamed device's wake words without a restart.
#HAL_CODEX_WORKSPACE_DIR=/root/.codex/workspace
#HAL_REALTIME_MEMORY_PATH=/tmp/realtime_memory.jsonl
#HAL_REALTIME_MAX_MEMORY_ENTRIES=1000   # Max entries in realtime memory JSONL
#HAL_REALTIME_MEMORY_TRIM_KEEP=500     # Keep this many when trimming
#HAL_REALTIME_MEMORY_COUNT=20          # Latest N realtime memory entries to load

# --- CPU / thread tuning (important for Raspberry Pi) ---
OMP_NUM_THREADS=1               # Limit OpenMP threads used by onnxruntime/numpy — prevents thread pool from spinning all 4 Pi cores
OPENBLAS_NUM_THREADS=1          # Same for OpenBLAS (used by numpy/scipy)

# --- Simulator (off-device only — never set these on a board) ---
# `make sim` sets all three; listed here as reference, not to be copied into
# /opt/hal/.env. Details in docs/simulator.md.
#HAL_SIMULATE=1        # 1|true|yes → virtual drivers instead of hardware
#HAL_BOARD=sim         # Virtual board profile; refuses to boot without HAL_SIMULATE=1
# virtual: deterministic, permission-free, voice pipeline stays inert.
# host: the dev machine's mic/camera/speaker AND the real voice pipeline
#       (STT → realtime → dispatch), the same code a board runs.
#HAL_SIM_MEDIA=virtual

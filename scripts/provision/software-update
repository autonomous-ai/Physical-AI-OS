#!/bin/bash
set -e
# Metadata URL from the bootstrap config; OTA_METADATA_URL env overrides. No default.
BOOTSTRAP_JSON="/root/config/bootstrap.json"
ROLLBACK_DIR="/root/bootstrap/rollback"
WEB_ROOT="/usr/share/nginx/html/setup"
HAL_DIR="/opt/hal"

find_hal_uv() {
  local candidate
  candidate="$(command -v uv || true)"
  if [ -n "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  # Reachy's installer uses Pollen's per-user uv even when running as root.
  for candidate in /root/.local/bin/uv /home/pollen/.local/bin/uv; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  echo "uv not found" >&2
  return 1
}

hal_dependency_extra() {
  local device_type
  device_type="$(grep -E '^DEVICE_TYPE=' "$HAL_DIR/.env" 2>/dev/null | cut -d= -f2)"
  if [ -z "$device_type" ]; then
    device_type="$(jq -r '.device_type // empty' /root/config/config.json 2>/dev/null || true)"
  fi
  case "$device_type" in
    reachy-mini) printf '%s\n' reachy ;;
    *) printf '%s\n' aec ;;
  esac
}

# npm's semver: engine ranges can include unions and upper bounds.
node_satisfies_engine() {
  node - "$1" "$(command -v npm)" <<'NODE'
const fs = require('fs');
const path = require('path');
try {
  const npmDir = path.dirname(fs.realpathSync(process.argv[3]));
  const semver = require(require.resolve('semver', { paths: [npmDir] }));
  const range = process.argv[2];
  if (!semver.validRange(range)) throw new Error('Invalid Node engine range');
  process.exit(semver.satisfies(process.version, range) ? 0 : 1);
} catch (error) {
  console.error('[software-update] Cannot check Node compatibility:', error.message);
  process.exit(2);
}
NODE
}

ensure_node_engine() {
  local engine="$1" component="$2" status setup_script
  if node_satisfies_engine "$engine"; then
    return 0
  else
    status=$?
    # A broken checker must not trigger a system package upgrade.
    [ "$status" -eq 1 ] || return "$status"
  fi
  echo "[software-update] $component requires Node $engine; upgrading system Node to 24.x"
  setup_script=$(mktemp) || return 1
  if ! curl -fsSL https://deb.nodesource.com/setup_24.x -o "$setup_script"; then
    rm -f "$setup_script"
    return 1
  fi
  if ! bash "$setup_script"; then
    rm -f "$setup_script"
    return 1
  fi
  rm -f "$setup_script"
  apt-get install -y nodejs || return 1
  hash -r
  node_satisfies_engine "$engine" || {
    echo "[software-update] Node still does not satisfy $engine; refusing $component update (check Node version and PATH)" >&2
    return 1
  }
}

ensure_openclaw_node() {
  local version="$1" engine_json engine
  engine_json=$(npm view "openclaw@$version" engines.node --json) || return 1
  engine=$(printf '%s' "$engine_json" | jq -er 'select(type == "string" and length > 0)') || {
    echo "[software-update] Missing Node requirement for openclaw@$version" >&2
    return 1
  }
  ensure_node_engine "$engine" "openclaw@$version"
}

# Print the first x.y.z[suffix] on stdin (Hermes prints several versions; take the first).
cli_semver() {
  grep -oE '[0-9]+\.[0-9]+\.[0-9]+([-.+_][0-9A-Za-z.-]+)?' | head -1
}

update_hermes_package() {
  ensure_node_engine '>=22.22.0 <23 || >=24.11.0 <25 || >=26.0.0' hermes || return 1
  hermes update
}

# update_hermes_pinned <full-sha>: check out the exact commit and rebuild via the upstream
# installer, stage by stage (the monolithic installer hangs on ARM). --force-commit allows rollback.
update_hermes_pinned() {
  local commit="$1" installer stage
  ensure_node_engine '>=22.22.0 <23 || >=24.11.0 <25 || >=26.0.0' hermes || return 1
  installer=$(mktemp)
  curl -fsSL "https://raw.githubusercontent.com/NousResearch/hermes-agent/${commit}/scripts/install.sh" -o "$installer" || { echo "[software-update] failed to fetch hermes installer @ $commit"; rm -f "$installer"; return 1; }
  for stage in repository venv python-deps path; do
    echo "[software-update] hermes installer stage: $stage (commit $commit)"
    bash "$installer" --stage "$stage" --non-interactive --commit "$commit" --force-commit || { echo "[software-update] hermes installer stage $stage failed"; rm -f "$installer"; return 1; }
  done
  rm -f "$installer"
  echo "git" >/usr/local/lib/hermes-agent/.install_method 2>/dev/null || true
  local head
  head=$(git -C /usr/local/lib/hermes-agent rev-parse HEAD 2>/dev/null || true)
  [ "$head" = "$commit" ] || { echo "[software-update] hermes checkout is $head, expected $commit"; return 1; }
}

update_openclaw() {
  local version="$1" attempt
  ensure_openclaw_node "$version" || return 1
  npm install -g "openclaw@$version" || { echo "npm install openclaw failed"; return 1; }
  openclaw plugins install "@openclaw/discord@$version" --force 2>&1 || echo "[software-update] WARN: discord plugin install failed (non-fatal)"
  openclaw plugins install "@openclaw/slack@$version" --force 2>&1 || echo "[software-update] WARN: slack plugin install failed (non-fatal)"
  # Use the system gateway's state paths, not the SSH user's.
  systemctl stop openclaw || return 1
  if ! HOME=/root OPENCLAW_HOME=/root/.openclaw OPENCLAW_STATE_DIR=/root/.openclaw \
    openclaw doctor --fix --non-interactive --no-workspace-suggestions; then
    echo "[software-update] OpenClaw migration failed; gateway left stopped. Resolve doctor errors before starting openclaw.service." >&2
    return 1
  fi
  systemctl restart openclaw || return 1
  for attempt in {1..12}; do
    if HOME=/root OPENCLAW_HOME=/root/.openclaw OPENCLAW_STATE_DIR=/root/.openclaw \
      openclaw gateway status --require-rpc --timeout 5000; then
      echo "openclaw updated to $version"
      return 0
    fi
    [ "$attempt" -eq 12 ] || sleep 5
  done
  echo "[software-update] OpenClaw gateway did not become ready after migration; check journalctl -u openclaw" >&2
  return 1
}

# Keep the full prior web bundle; replace the backup only after the new ZIP is staged.
save_web_service_state() {
  mkdir -p "$ROLLBACK_DIR"
  if systemctl is-active --quiet nginx; then
    echo active >"$ROLLBACK_DIR/web.nginx-state"
  else
    echo inactive >"$ROLLBACK_DIR/web.nginx-state"
  fi
}

# Whether the unit should run after the update: enabled counts as yes, since the start-of-run
# snapshot can record "inactive" left by a previous failed update.
unit_wanted_active() {
  local unit="$1" state_file="$2"
  [ "$(cat "$state_file" 2>/dev/null || echo active)" = active ] && return 0
  if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
    echo "[software-update] $unit was recorded inactive but is enabled — starting it (a failed earlier run can poison that snapshot)"
    return 0
  fi
  return 1
}

web_was_active() {
  unit_wanted_active nginx "$ROLLBACK_DIR/web.nginx-state"
}

restore_web_service_state() {
  if web_was_active; then
    systemctl restart nginx
  else
    systemctl stop nginx 2>/dev/null || true
  fi
}

wait_for_web() {
  local attempt=1
  while [ "$attempt" -le 30 ]; do
    curl -fsS --max-time 5 http://127.0.0.1/ >/dev/null 2>&1 && return 0
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

check_web() {
  [ -f "$WEB_ROOT/index.html" ] || return 1
  nginx -t >/dev/null || return 1
  web_was_active || return 0
  systemctl is-active --quiet nginx || return 1
  wait_for_web || return 1
  systemctl is-active --quiet nginx
}

restore_web_backup() {
  local backup="$ROLLBACK_DIR/web.previous" failed="$ROLLBACK_DIR/web.failed"
  [ -d "$backup" ] || { echo "No rollback backup for web" >&2; return 1; }
  rm -rf "$failed"
  [ ! -e "$WEB_ROOT" ] || mv "$WEB_ROOT" "$failed"
  mv "$backup" "$WEB_ROOT"
}

resolve_device_profile() {
  DEVICE_TYPE="$(grep -E '^DEVICE_TYPE=' /opt/hal/.env 2>/dev/null | cut -d= -f2)"
  [ -z "$DEVICE_TYPE" ] && DEVICE_TYPE="$(jq -r '.device_type // empty' /root/config/config.json 2>/dev/null)"
  [ -n "$DEVICE_TYPE" ] || { echo "ERROR: device_type not found in /opt/hal/.env or /root/config/config.json" >&2; return 1; }
  DEVICES_DIR="$(grep -E '^DEVICES_DIR=' /opt/hal/.env 2>/dev/null | cut -d= -f2)"
  [ -n "$DEVICES_DIR" ] || DEVICES_DIR=/opt/devices
  DEVICE_DEST="$DEVICES_DIR/$DEVICE_TYPE"
}

save_device_service_state() {
  mkdir -p "$ROLLBACK_DIR"
  for unit in os-server hal; do
    if systemctl is-active --quiet "$unit"; then
      echo "$unit=active"
    else
      echo "$unit=inactive"
    fi
  done >"$ROLLBACK_DIR/device.services"
}

device_was_active() {
  local unit="$1"
  grep -qx "$unit=active" "$ROLLBACK_DIR/device.services" 2>/dev/null && return 0
  [ ! -f "$ROLLBACK_DIR/device.services" ] && return 0
  if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
    echo "[software-update] $unit was recorded inactive but is enabled — starting it"
    return 0
  fi
  return 1
}

restore_device_service_state() {
  if device_was_active os-server; then systemctl restart os-server || return 1; else systemctl stop os-server 2>/dev/null || true; fi
  if device_was_active hal; then systemctl restart hal || return 1; else systemctl stop hal 2>/dev/null || true; fi
}

wait_for_url() {
  local url="$1" max_attempts="$2" attempt=1
  while [ "$attempt" -le "$max_attempts" ]; do
    curl -fsS --max-time 5 "$url" >/dev/null 2>&1 && return 0
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

# Older images lack the Harness WebSocket route; migrate nginx before a Harness-capable install.
ensure_harness_nginx_location() {
  command -v nginx >/dev/null 2>&1 || {
    echo "[software-update] nginx is not installed; cannot install Harness route" >&2
    return 1
  }
  local conf candidate changed
  conf=""
  for candidate in /etc/nginx/conf.d/*.conf /etc/nginx/sites-enabled/*; do
    [ -f "$candidate" ] || continue
    if grep -q 'location /api/ {' "$candidate" || grep -q 'location = /api/harness/ws' "$candidate"; then
      conf="$candidate"
      break
    fi
  done
  [ -n "$conf" ] || {
    echo "[software-update] nginx API proxy configuration was not found" >&2
    return 1
  }
  changed=$(python3 - "$conf" <<'PY'
import os
import re
import sys

# sites-enabled entries may be symlinks; update their source, not the link.
path = os.path.realpath(sys.argv[1])
with open(path) as source:
    content = source.read()
if "location = /api/harness/ws" in content:
    print("0")
    raise SystemExit(0)
anchor = "  location /api/ {"
if content.count(anchor) != 1:
    raise SystemExit("nginx /api/ proxy anchor differs; refusing to edit")
# Reuse the API upstream: Reachy's spike image names it spike_backend.
# Reject unfamiliar/nested blocks and URI rewriting rather than invent a route.
api = re.search(r"(?m)^  location /api/ \{([^{}]*)\}", content)
targets = re.findall(r"(?m)^\s*proxy_pass\s+(http://[A-Za-z0-9_.:-]+);\s*(?:#.*)?$", api[1]) if api else []
if len(targets) != 1:
    raise SystemExit("nginx /api/ proxy target differs; refusing to edit")
route = '''  # Direct Harness pairing/session; authenticated by PAKE and pinned E2EE.
  location = /api/harness/ws {
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
  }

'''
route = route.replace("proxy_pass http://backend;", "proxy_pass " + targets[0] + ";", 1)
temporary = path + ".harness-new"
with open(temporary, "w") as target:
    target.write(content.replace(anchor, route + anchor, 1))
os.chmod(temporary, os.stat(path).st_mode & 0o777)
os.replace(temporary, path)
print("1")
PY
  ) || return 1
  nginx -t >/dev/null || return 1
  if [ "$changed" = "1" ]; then
    systemctl reload nginx
    echo "[software-update] nginx Harness WebSocket route installed"
  fi
}

check_device_profile() {
  [ -f "$DEVICE_DEST/ROBOT.md" ] || return 1
  local unit url attempts
  for unit in hal os-server; do
    device_was_active "$unit" || continue
    if [ "$unit" = hal ]; then url=http://127.0.0.1:5001/health; attempts=120
    else url=http://127.0.0.1:5000/api/health/live; attempts=60; fi
    systemctl is-active --quiet "$unit" || return 1
    wait_for_url "$url" "$attempts" || return 1
    systemctl is-active --quiet "$unit" || return 1
  done
  return 0
}

snapshot_device_rootfs() {
  # Record absent files too, so rollback removes files added by the failed OTA.
  local old_rootfs="$1" new_rootfs="$2" archive="${3:-$ROLLBACK_DIR/device.previous.rootfs}"
  local list rel target state
  list=$(mktemp)
  rm -rf "$archive"
  mkdir -p "$archive/files"
  { [ -d "$old_rootfs" ] && (cd "$old_rootfs" && find . \( -type f -o -type l \) -print); [ -d "$new_rootfs" ] && (cd "$new_rootfs" && find . \( -type f -o -type l \) -print); } | sort -u >"$list"
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    target="/${rel#./}"
    if [ -e "$target" ] || [ -L "$target" ]; then
      state=present
      mkdir -p "$archive/files/$(dirname "${rel#./}")"
      cp -a "$target" "$archive/files/${rel#./}"
    else
      state=absent
    fi
    printf '%s\t%s\n' "$rel" "$state" >>"$archive/manifest"
  done <"$list"
  rm -f "$list"
}

restore_device_rootfs() {
  local archive="${1:-$ROLLBACK_DIR/device.previous.rootfs}" rel state target
  [ -f "$archive/manifest" ] || return 0
  while IFS=$'\t' read -r rel state; do
    target="/${rel#./}"
    if [ "$state" = present ]; then
      mkdir -p "$(dirname "$target")" || return 1
      cp -a "$archive/files/${rel#./}" "$target" || return 1
    else
      rm -f "$target" || return 1
    fi
  done <"$archive/manifest"
}

restore_device_backup() {
  local backup="$ROLLBACK_DIR/device.previous" failed="$ROLLBACK_DIR/device.failed"
  [ -d "$backup" ] || { echo "No rollback backup for device" >&2; return 1; }
  rm -rf "$failed"
  [ ! -e "$DEVICE_DEST" ] || mv "$DEVICE_DEST" "$failed"
  mv "$backup" "$DEVICE_DEST"
  restore_device_rootfs
  systemctl daemon-reload
}

save_hal_service_state() {
  mkdir -p "$ROLLBACK_DIR"
  if systemctl is-active --quiet hal; then echo active >"$ROLLBACK_DIR/hal.service-state"; else echo inactive >"$ROLLBACK_DIR/hal.service-state"; fi
}

hal_was_active() {
  unit_wanted_active hal "$ROLLBACK_DIR/hal.service-state"
}

restore_hal_service_state() {
  if hal_was_active; then systemctl restart hal; else systemctl stop hal 2>/dev/null || true; fi
}

check_hal() {
  [ -f "$HAL_DIR/VERSION_HAL" ] || return 1
  # Only an intentionally stopped, disabled HAL may skip runtime validation.
  # A failed start must not turn the new runtime into an accepted update.
  hal_was_active || return 0
  systemctl is-active --quiet hal || return 1
  wait_for_url http://127.0.0.1:5001/health 120 || return 1
  systemctl is-active --quiet hal
}

# mktemp -d staging dirs are 0700; publish with the live tree's mode (nginx needs to read the web root).
publish_mode() {
  local staged="$1" reference="$2"
  # Floor at 0755 so a bad mode doesn't propagate forever.
  local ref_mode=""
  [ ! -d "$reference" ] || ref_mode="$(stat -c "%a" "$reference" 2>/dev/null || true)"
  case "$ref_mode" in
    755|775|777|745|750) chmod "$ref_mode" "$staged" ;;
    *) chmod 0755 "$staged" ;;
  esac
}

# Venvs aren't relocatable: rewrite the staging path in .venv shebangs after the move (else 203/EXEC).
relocate_venv_scripts() {
  local venv="$1" from="$2" to="$3"
  [ -d "$venv/bin" ] || return 0
  grep -rlI --binary-files=without-match -- "$from" "$venv/bin" 2>/dev/null \
    | xargs -r sed -i "s|$from|$to|g"
  [ ! -f "$venv/pyvenv.cfg" ] || sed -i "s|$from|$to|g" "$venv/pyvenv.cfg"
}

# The journal survives process death. It remains pending until health succeeds.
PENDING_MOVED_FROM=""
PENDING_MOVED_TO=""
PENDING_RESTORE_SERVICES=""
STOPPED_SERVICES_RESTORE=""

arm_service_restore() {
  STOPPED_SERVICES_RESTORE="$1"
}

disarm_service_restore() {
  STOPPED_SERVICES_RESTORE=""
}

mark_publish_pending() {
  local journal="$ROLLBACK_DIR/pending-update.json" temporary had_live=false
  [ ! -e "$journal" ] || { echo "Unrecovered update journal: $journal" >&2; return 1; }
  mkdir -p "$ROLLBACK_DIR" || return 1
  temporary=$(mktemp "$ROLLBACK_DIR/.pending-update.XXXXXX") || return 1
  [ ! -e "$1" ] && [ ! -e "$2" ] || had_live=true
  jq -n --arg live "$1" --arg backup "$2" --arg restore "$3" --argjson had_live "$had_live" \
    --arg staged "${4:-${DIR_TMP:-}}" --arg rootfs "${DEVICE_ROOTFS_SNAPSHOT:-}" \
    '{live:$live, backup:$backup, restore:$restore, staged:$staged, had_live:$had_live, rootfs:$rootfs}' >"$temporary" || return 1
  # Flush staged files and journal before removing the last live tree.
  sync || return 1
  mv "$temporary" "$journal" || return 1
  sync || return 1
  PENDING_MOVED_FROM="$1"
  PENDING_MOVED_TO="$2"
  PENDING_RESTORE_SERVICES="$3"
  arm_service_restore "$3"
}

clear_publish_pending() {
  # Persist the restored/healthy tree before marking this transaction complete.
  sync || return 1
  rm -f "$ROLLBACK_DIR/pending-update.json" || return 1
  sync || return 1
  PENDING_MOVED_FROM=""
  PENDING_MOVED_TO=""
  PENDING_RESTORE_SERVICES=""
}

recover_pending_update() {
  local journal="$ROLLBACK_DIR/pending-update.json" live backup restore staged failed check had_live rootfs
  if [ ! -f "$journal" ]; then
    if [ ! -d "$HAL_DIR" ] && [ -d "$ROLLBACK_DIR/hal.previous" ]; then
      mark_publish_pending "$HAL_DIR" "$ROLLBACK_DIR/hal.previous" restore_hal_service_state || return 1
    else
      return 0
    fi
  fi
  live=$(jq -er '.live | strings | select(length > 0)' "$journal") || return 1
  backup=$(jq -er '.backup | strings | select(length > 0)' "$journal") || return 1
  restore=$(jq -er '.restore | strings' "$journal") || return 1
  rootfs=$(jq -r '.rootfs // empty' "$journal") || return 1
  case "$rootfs" in ""|"$ROLLBACK_DIR"/.device.rootfs.new.*) ;; *) return 1 ;; esac
  had_live=$(jq -r 'if has("had_live") then .had_live else true end' "$journal") || return 1
  staged=$(jq -r '.staged // empty' "$journal") || return 1
  case "$restore" in
    restore_hal_service_state)
      [ "$live" = "$HAL_DIR" ] && [ "$backup" = "$ROLLBACK_DIR/hal.previous" ] || return 1
      systemctl stop hal || return 1; check=check_hal ;;
    restore_web_service_state)
      [ "$live" = "$WEB_ROOT" ] && [ "$backup" = "$ROLLBACK_DIR/web.previous" ] || return 1
      systemctl stop nginx || return 1; check=check_web ;;
    restore_device_service_state)
      [ "$backup" = "$ROLLBACK_DIR/device.previous" ] && [[ "$live" = /* ]] && [ "$live" != / ] || return 1
      DEVICE_DEST="$live"
      systemctl stop os-server || return 1
      systemctl stop hal || return 1; check=check_device_profile ;;
    restore_os_server_service)
      [ "$live" = /usr/local/bin/os-server ] && [ "$backup" = "$ROLLBACK_DIR/os-server.previous" ] || return 1
      systemctl stop os-server || return 1; check=check_os_server ;;
    restore_bootstrap_service)
      [ "$live" = /usr/local/bin/bootstrap-server ] && [ "$backup" = "$ROLLBACK_DIR/bootstrap.previous" ] || return 1
      systemctl stop bootstrap || return 1; check=check_bootstrap ;;
    *) echo "Unknown OTA recovery action: $restore" >&2; return 1 ;;
  esac
  echo "[software-update] recovering unfinished update: $live"
  failed="${backup%.previous}.failed"
  if [ -e "$backup" ]; then
    rm -rf "$failed" || return 1
    [ ! -e "$live" ] || mv "$live" "$failed" || return 1
    mv "$backup" "$live" || return 1
  elif [ "$had_live" = false ]; then
    # A first install has no previous runtime. Remove the failed candidate so
    # its version file cannot make the next poll mistake it for an installation.
    rm -rf "$failed" || return 1
    [ ! -e "$live" ] || mv "$live" "$failed" || return 1
    clear_publish_pending || return 1
    disarm_service_restore
    echo "[software-update] failed first install removed; no prior runtime to restore"
    return 0
  elif [ ! -e "$live" ]; then
    echo "Neither live runtime nor rollback backup exists: $live" >&2
    return 1
  fi
  if [ "$restore" = restore_device_service_state ]; then
    [ -z "$rootfs" ] || [ -f "$rootfs/manifest" ] || return 1
    restore_device_rootfs "$rootfs" || return 1
    systemctl daemon-reload || return 1
  fi
  "$restore" || return 1
  "$check" || { echo "Recovered service is not healthy; keeping recovery journal" >&2; return 1; }
  clear_publish_pending || return 1
  disarm_service_restore
  [ -z "$rootfs" ] || rm -rf "$rootfs"
  # Stage paths originate in mktemp; never remove an arbitrary journal path.
  case "$staged" in
    "$(dirname "$live")"/.*.new.*) [ ! -e "$staged" ] || rm -rf "$staged" ;;
  esac
}

on_exit() {
  local code=$?
  trap - EXIT
  if [ -f "$ROLLBACK_DIR/pending-update.json" ]; then
    # A pending journal at exit is never a successful update.
    [ "$code" -ne 0 ] || code=1
    recover_pending_update || echo "[software-update] recovery incomplete; journal retained for retry" >&2
  elif [ -n "$STOPPED_SERVICES_RESTORE" ]; then
    "$STOPPED_SERVICES_RESTORE" || true
    disarm_service_restore
  fi
  rm -f "${METADATA_TMP:-}" "${METADATA_PAYLOAD:-}" "${ZIP_TMP:-}" 2>/dev/null || true
  [ -z "${DIR_TMP:-}" ] || rm -rf "$DIR_TMP"
  exit "$code"
}

restore_os_server_service() {
  systemctl restart os-server
}

restore_bootstrap_service() {
  systemctl restart bootstrap
}

check_os_server() {
  systemctl is-active --quiet os-server || return 1
  wait_for_url http://127.0.0.1:5000/api/health/live 60 || return 1
  systemctl is-active --quiet os-server
}

check_bootstrap() {
  local port
  port=$(jq -r '.httpPort // 8080' "$BOOTSTRAP_JSON") || return 1
  [[ "$port" =~ ^[0-9]+$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || return 1
  systemctl is-active --quiet bootstrap || return 1
  wait_for_url "http://127.0.0.1:$port/health" 60 || return 1
  systemctl is-active --quiet bootstrap
}

update_core_binary() {
  local unit="$1" destination="$2" candidate="$3" restore="$4" check="$5" staged
  staged=$(mktemp "$(dirname "$destination")/.${unit}.new.XXXXXX") || return 1
  install -m 0755 "$candidate" "$staged" || return 1
  # Validate executable format before disturbing the current service.
  timeout 15 "$staged" --version >/dev/null || { rm -f "$staged"; return 1; }
  install -D -m 0755 "$destination" "$ROLLBACK_DIR/$unit.previous" || return 1
  mark_publish_pending "$destination" "$ROLLBACK_DIR/$unit.previous" "$restore" "$staged" || return 1
  # Atomic rename avoids a partially copied live executable.
  mv -f "$staged" "$destination" || return 1
  "$restore" || return 1
  "$check" || return 1
  clear_publish_pending || return 1
  disarm_service_restore
}

restore_hal_backup() {
  local backup="$ROLLBACK_DIR/hal.previous" failed="$ROLLBACK_DIR/hal.failed"
  [ -d "$backup" ] || { echo "No rollback backup for hal" >&2; return 1; }
  rm -rf "$failed"
  [ ! -e "$HAL_DIR" ] || mv "$HAL_DIR" "$failed"
  mv "$backup" "$HAL_DIR"
}

[ "$(id -u)" -ne 0 ] && { echo "Run as root."; exit 1; }

# Run the update in a transient systemd service (--wait): stopping os-server/nginx kills the
# caller's cgroup, so an inline run would be abandoned half-done. Not --scope: a scope dies with its client.
if [ -z "${SOFTWARE_UPDATE_DETACHED:-}" ] && command -v systemd-run >/dev/null 2>&1; then
  SU_UNIT="software-update-$1-$$"
  if systemd-run --unit="probe-$SU_UNIT" --collect --quiet --wait \
      --service-type=oneshot -- /bin/true >/dev/null 2>&1; then
    SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
    # Transient units start with a clean env; forward every ${VAR:-} this script reads.
    SU_ENV=()
    for v in OTA_METADATA_URL HAL_UV_CACHE; do
      [ -z "${!v:-}" ] || SU_ENV+=("--setenv=$v=${!v}")
    done
    echo "[software-update] running as $SU_UNIT.service — follow with: journalctl -fu $SU_UNIT"
    exec systemd-run --unit="$SU_UNIT" --collect --quiet --wait \
      --service-type=oneshot --setenv=SOFTWARE_UPDATE_DETACHED=1 \
      "${SU_ENV[@]}" -- "$SELF" "$@"
  fi
  echo "[software-update] transient units unavailable — running inline" >&2
fi
# One update at a time: concurrent runs delete each other's .previous backup.
exec 9>/var/lock/software-update.lock
if ! flock -n 9; then
  echo "[software-update] another update is already running (pid $(cat /var/lock/software-update.pid 2>/dev/null)) — refusing to run a second one"
  exit 1
fi
echo $$ >/var/lock/software-update.pid
[ $# -lt 1 ] && { echo "Usage: software-update <component>|rollback <os-server|bootstrap|web|device|hal|codex|opencode|picoclaw>"; exit 1; }
APP="$1"
recover_pending_update || { echo "Pending OTA recovery failed; refusing another update" >&2; exit 1; }
[ "$APP" != recover ] || { echo "OTA recovery complete"; exit 0; }
if [ "$APP" = "rollback" ]; then
  [ $# -eq 2 ] || { echo "Usage: software-update rollback <os-server|bootstrap|web|device|hal|codex|opencode|picoclaw>"; exit 1; }
  ROLLBACK_TARGET="$2"
  if [ "$ROLLBACK_TARGET" = "web" ]; then
    BACKUP="$ROLLBACK_DIR/web.previous"
    [ -d "$BACKUP" ] || { echo "No rollback backup for web"; exit 1; }
    BLOCKED_VERSION="$(cat "$WEB_ROOT/VERSION" 2>/dev/null || true)"
    if [ -z "$BLOCKED_VERSION" ] && [ -f /root/bootstrap/state.json ]; then
      BLOCKED_VERSION=$(jq -r '.components.web // empty' /root/bootstrap/state.json 2>/dev/null || true)
    fi
    if [ -n "$BLOCKED_VERSION" ] && [ -f "$BOOTSTRAP_JSON" ]; then
      CONFIG_TMP=$(mktemp)
      if jq --arg version "$BLOCKED_VERSION" '.rollback_versions = (.rollback_versions // {}) | .rollback_versions.web = $version' "$BOOTSTRAP_JSON" >"$CONFIG_TMP"; then
        mv "$CONFIG_TMP" "$BOOTSTRAP_JSON"
      else
        rm -f "$CONFIG_TMP"
        echo "WARN: could not record rollback version; lower min_version before the next OTA poll"
      fi
    fi
    arm_service_restore restore_web_service_state
    systemctl stop nginx 2>/dev/null || true
    restore_web_backup
    restore_web_service_state
    disarm_service_restore
    check_web || { echo "web rollback health check failed"; exit 1; }
    echo "web restored from $BACKUP"
    exit 0
  fi
  if [ "$ROLLBACK_TARGET" = "device" ]; then
    resolve_device_profile || exit 1
    BACKUP="$ROLLBACK_DIR/device.previous"
    [ -d "$BACKUP" ] || { echo "No rollback backup for device"; exit 1; }
    BLOCKED_VERSION="$(cat "$DEVICE_DEST/VERSION" 2>/dev/null || true)"
    if [ -z "$BLOCKED_VERSION" ] && [ -f /root/bootstrap/state.json ]; then
      BLOCKED_VERSION=$(jq -r '.components.device // empty' /root/bootstrap/state.json 2>/dev/null || true)
    fi
    if [ -n "$BLOCKED_VERSION" ] && [ -f "$BOOTSTRAP_JSON" ]; then
      CONFIG_TMP=$(mktemp)
      if jq --arg version "$BLOCKED_VERSION" '.rollback_versions = (.rollback_versions // {}) | .rollback_versions.device = $version' "$BOOTSTRAP_JSON" >"$CONFIG_TMP"; then mv "$CONFIG_TMP" "$BOOTSTRAP_JSON"; else rm -f "$CONFIG_TMP"; echo "WARN: could not record rollback version; lower min_version before the next OTA poll"; fi
    fi
    arm_service_restore restore_device_service_state
    systemctl stop os-server 2>/dev/null || true
    systemctl stop hal 2>/dev/null || true
    restore_device_backup
    restore_device_service_state
    disarm_service_restore
    check_device_profile || { echo "device rollback health check failed"; exit 1; }
    echo "device restored from $BACKUP"
    exit 0
  fi
  if [ "$ROLLBACK_TARGET" = "hal" ]; then
    BACKUP="$ROLLBACK_DIR/hal.previous"
    [ -d "$BACKUP" ] || { echo "No rollback backup for hal"; exit 1; }
    BLOCKED_VERSION="$(cat "$HAL_DIR/VERSION_HAL" 2>/dev/null || true)"
    if [ -z "$BLOCKED_VERSION" ] && [ -f /root/bootstrap/state.json ]; then BLOCKED_VERSION=$(jq -r '.components.hal // empty' /root/bootstrap/state.json 2>/dev/null || true); fi
    if [ -n "$BLOCKED_VERSION" ] && [ -f "$BOOTSTRAP_JSON" ]; then
      CONFIG_TMP=$(mktemp)
      if jq --arg version "$BLOCKED_VERSION" '.rollback_versions = (.rollback_versions // {}) | .rollback_versions.hal = $version' "$BOOTSTRAP_JSON" >"$CONFIG_TMP"; then mv "$CONFIG_TMP" "$BOOTSTRAP_JSON"; else rm -f "$CONFIG_TMP"; echo "WARN: could not record rollback version; lower min_version before the next OTA poll"; fi
    fi
    arm_service_restore restore_hal_service_state
    systemctl stop hal 2>/dev/null || true
    restore_hal_backup
    restore_hal_service_state
    disarm_service_restore
    check_hal || { echo "HAL rollback health check failed"; exit 1; }
    echo "hal restored from $BACKUP"
    exit 0
  fi
  case "$ROLLBACK_TARGET" in
    os-server) DEST=/usr/local/bin/os-server; UNIT=os-server ;;
    bootstrap) DEST=/usr/local/bin/bootstrap-server; UNIT=bootstrap ;;
    codex) DEST=/usr/local/bin/codex; UNIT=codex ;;
    opencode) DEST=/usr/local/bin/opencode; UNIT=opencode ;;
    picoclaw) DEST=/usr/local/bin/picoclaw; UNIT=picoclaw ;;
    *) echo "Rollback is currently supported for os-server, bootstrap, codex, opencode and picoclaw only"; exit 1 ;;
  esac
  BACKUP="/root/bootstrap/rollback/${ROLLBACK_TARGET}.previous"
  [ -x "$BACKUP" ] || { echo "No rollback backup for $ROLLBACK_TARGET"; exit 1; }
  BLOCKED_VERSION=$("$DEST" --version 2>/dev/null | cli_semver)
  if [ -z "$BLOCKED_VERSION" ] && [ -f /root/bootstrap/state.json ]; then
    BLOCKED_VERSION=$(jq -r --arg key "$ROLLBACK_TARGET" '.components[$key] // empty' /root/bootstrap/state.json 2>/dev/null || true)
  fi
  if [ -n "$BLOCKED_VERSION" ] && [ -f "$BOOTSTRAP_JSON" ]; then
    CONFIG_TMP=$(mktemp)
    if jq --arg key "$ROLLBACK_TARGET" --arg version "$BLOCKED_VERSION" '.rollback_versions = (.rollback_versions // {}) | .rollback_versions[$key] = $version' "$BOOTSTRAP_JSON" >"$CONFIG_TMP"; then
      mv "$CONFIG_TMP" "$BOOTSTRAP_JSON"
    else
      rm -f "$CONFIG_TMP"
      echo "WARN: could not record rollback version; lower min_version before the next OTA poll"
    fi
  fi
  install -D -m 0755 "$BACKUP" "$DEST"
  # Runtime units exist only after switching to that runtime; don't fail the rollback.
  if { [ "$ROLLBACK_TARGET" = "codex" ] || [ "$ROLLBACK_TARGET" = "opencode" ] || [ "$ROLLBACK_TARGET" = "picoclaw" ]; } && [ ! -f "/etc/systemd/system/${UNIT}.service" ]; then
    echo "[software-update] ${UNIT}.service absent (runtime not active) — binary restored, no restart"
  else
    systemctl restart "$UNIT"
  fi
  [ "$ROLLBACK_TARGET" != "bootstrap" ] && systemctl restart bootstrap
  echo "$ROLLBACK_TARGET restored from $BACKUP"
  exit 0
fi
case "$APP" in
  os-server|openclaw|codex|claudecode|opencode|hermes|picoclaw|bootstrap|web|hal|claude-desktop-buddy|device) ;;
  *) echo "Unknown app: $APP. Use os-server, openclaw, codex, claudecode, opencode, hermes, picoclaw, bootstrap, web, hal, claude-desktop-buddy, or device."; exit 1 ;;
esac

if [ -z "${OTA_METADATA_URL:-}" ]; then
  OTA_METADATA_URL="$(jq -r '.metadata_url // empty' "$BOOTSTRAP_JSON" 2>/dev/null || true)"
fi
if [ -z "$OTA_METADATA_URL" ]; then
  echo "[software-update] ERROR: no metadata_url in $BOOTSTRAP_JSON and OTA_METADATA_URL unset"
  exit 1
fi
echo "[software-update] OTA metadata: $OTA_METADATA_URL"

if [ "$APP" = "os-server" ] || [ "$APP" = "web" ] || [ "$APP" = "device" ]; then
  ensure_harness_nginx_location || {
    echo "[software-update] Harness nginx migration failed; refusing $APP update" >&2
    exit 1
  }
fi

METADATA_TMP=$(mktemp)
METADATA_PAYLOAD=$(mktemp)
ZIP_TMP=""
DIR_TMP=""
trap on_exit EXIT
# INT/TERM/HUP run the same restore; HUP is what an interrupted SSH sends.
trap 'exit 130' INT
trap 'exit 143' TERM HUP
curl -fsSL -H "Cache-Control: no-cache" -H "Pragma: no-cache" -o "$METADATA_TMP" "$OTA_METADATA_URL" || { echo "Failed to fetch metadata from $OTA_METADATA_URL"; exit 1; }
OTA_SIGNING_PUBLIC_KEY="$(jq -r '.signing_public_key // empty' "$BOOTSTRAP_JSON" 2>/dev/null || true)"
if [ -n "$OTA_SIGNING_PUBLIC_KEY" ]; then
  PUBLIC_DER=$(mktemp); SIGNATURE_TMP=$(mktemp)
  jq -er '(.signed // .) | .format == "autonomous-ota/v1" and .signature.algorithm == "ed25519"' "$METADATA_TMP" >/dev/null || { echo "Unsigned or unsupported OTA metadata"; exit 1; }
  printf '\060\052\060\005\006\003\053\145\160\003\041\000' > "$PUBLIC_DER"
  printf '%s' "$OTA_SIGNING_PUBLIC_KEY" | base64 -d >> "$PUBLIC_DER" || { echo "Invalid OTA signing public key"; exit 1; }
  jq -r '(.signed // .).payload' "$METADATA_TMP" | base64 -d > "$METADATA_PAYLOAD" || { echo "Invalid OTA metadata payload"; exit 1; }
  jq -r '(.signed // .).signature.value' "$METADATA_TMP" | base64 -d > "$SIGNATURE_TMP" || { echo "Invalid OTA metadata signature"; exit 1; }
  openssl pkeyutl -verify -pubin -keyform DER -inkey "$PUBLIC_DER" -rawin -in "$METADATA_PAYLOAD" -sigfile "$SIGNATURE_TMP" >/dev/null || { echo "OTA metadata signature verification failed"; exit 1; }
else
  echo "[software-update] WARN: OTA signing is not configured; using legacy unsigned metadata"
  cp "$METADATA_TMP" "$METADATA_PAYLOAD"
fi
if [ "$APP" = "device" ]; then
  DEVICE_TYPE="$(grep -E '^DEVICE_TYPE=' /opt/hal/.env 2>/dev/null | cut -d= -f2)"
  [ -z "$DEVICE_TYPE" ] && DEVICE_TYPE="$(jq -r '.device_type // empty' /root/config/config.json 2>/dev/null)"
  # No lamp fallback: the wrong profile would overwrite this device's persona.
  [ -z "$DEVICE_TYPE" ] && { echo "ERROR: device_type not found in /opt/hal/.env or /root/config/config.json — cannot resolve device profile"; exit 1; }
  VERSION=$(jq -r --arg t "$DEVICE_TYPE" '.devices[$t].version // empty' "$METADATA_PAYLOAD")
  URL=$(jq -r --arg t "$DEVICE_TYPE" '.devices[$t].url // empty' "$METADATA_PAYLOAD")
  SHA256=$(jq -r --arg t "$DEVICE_TYPE" '.devices[$t].sha256 // empty' "$METADATA_PAYLOAD")
else
  META_KEY="$APP"
  VERSION=$(jq -r --arg a "$META_KEY" '.[$a].version // empty' "$METADATA_PAYLOAD")
  URL=$(jq -r --arg a "$META_KEY" '.[$a].url // empty' "$METADATA_PAYLOAD")
  SHA256=$(jq -r --arg a "$META_KEY" '.[$a].sha256 // empty' "$METADATA_PAYLOAD")
fi
[ -z "$VERSION" ] && { echo "Metadata has no version for $APP"; exit 1; }
[ -z "$URL" ] || [ -z "$OTA_SIGNING_PUBLIC_KEY" ] || [[ "$SHA256" =~ ^[a-fA-F0-9]{64}$ ]] || { echo "Metadata has no valid SHA-256 for $APP"; exit 1; }

download_verified() {
  local url="$1" destination="$2" digest="$3"
  curl -fsSL -H "Cache-Control: no-cache" -o "$destination" "$url" || return 1
  [ -z "$digest" ] || echo "$digest  $destination" | sha256sum -c - >/dev/null
}

if [ "$APP" = "os-server" ]; then
  [ -z "$URL" ] && { echo "Metadata has no url for os-server"; exit 1; }
  ZIP_TMP=$(mktemp)
  DIR_TMP=$(mktemp -d)
  download_verified "$URL" "$ZIP_TMP" "$SHA256" || { echo "Failed checksum verification for os-server"; exit 1; }
  unzip -o -q "$ZIP_TMP" -d "$DIR_TMP"
  BIN=$(find "$DIR_TMP" -type f -executable 2>/dev/null | head -1)
  [ -z "$BIN" ] && BIN=$(find "$DIR_TMP" -type f 2>/dev/null | head -1)
  [ -z "$BIN" ] || [ ! -f "$BIN" ] && { echo "No binary in os-server zip"; exit 1; }
  update_core_binary os-server /usr/local/bin/os-server "$BIN" restore_os_server_service check_os_server
  echo "os-server updated to $VERSION"
elif [ "$APP" = "bootstrap" ]; then
  [ -z "$URL" ] && { echo "Metadata has no url for bootstrap"; exit 1; }
  ZIP_TMP=$(mktemp)
  DIR_TMP=$(mktemp -d)
  download_verified "$URL" "$ZIP_TMP" "$SHA256" || { echo "Failed checksum verification for bootstrap"; exit 1; }
  unzip -o -q "$ZIP_TMP" -d "$DIR_TMP"
  BIN=$(find "$DIR_TMP" -type f -executable 2>/dev/null | head -1)
  [ -z "$BIN" ] && BIN=$(find "$DIR_TMP" -type f 2>/dev/null | head -1)
  [ -z "$BIN" ] || [ ! -f "$BIN" ] && { echo "No binary in bootstrap zip"; exit 1; }
  update_core_binary bootstrap /usr/local/bin/bootstrap-server "$BIN" restore_bootstrap_service check_bootstrap
  echo "bootstrap updated to $VERSION"
elif [ "$APP" = "openclaw" ]; then
  update_openclaw "$VERSION"
elif [ "$APP" = "codex" ]; then
  # Codex: static musl binary from GitHub releases; metadata carries bare semver, tag adds "rust-v".
  # Only the binary is touched; config stays owned by presync.
  [ -x /usr/local/bin/codex ] || { echo "codex is not installed on this device — switch the runtime to codex first"; exit 1; }
  case "$(uname -m)" in
    aarch64|arm64) CODEX_ASSET="codex-aarch64-unknown-linux-musl.tar.gz" ;;
    x86_64)        CODEX_ASSET="codex-x86_64-unknown-linux-musl.tar.gz" ;;
    *) echo "Unsupported arch $(uname -m) for codex"; exit 1 ;;
  esac
  CODEX_URL="https://github.com/openai/codex/releases/download/rust-v${VERSION}/${CODEX_ASSET}"
  DIR_TMP=$(mktemp -d)
  echo "[software-update] downloading $CODEX_URL"
  # No sha256 (upstream artifact); tar extraction is the integrity check.
  download_verified "$CODEX_URL" "$DIR_TMP/$CODEX_ASSET" "" || { echo "Failed to download codex $VERSION"; exit 1; }
  tar -xzf "$DIR_TMP/$CODEX_ASSET" -C "$DIR_TMP" || { echo "Corrupt codex tarball for $VERSION"; exit 1; }
  CODEX_SRC="$DIR_TMP/${CODEX_ASSET%.tar.gz}"
  [ -f "$CODEX_SRC" ] || { echo "No codex binary in tarball"; exit 1; }
  install -D -m 0755 /usr/local/bin/codex /root/bootstrap/rollback/codex.previous
  install -m 0755 "$CODEX_SRC" /usr/local/bin/codex
  /usr/local/bin/codex --version || { echo "codex binary not runnable after update"; exit 1; }
  # The unit exists only after switching to the codex runtime.
  if [ -f /etc/systemd/system/codex.service ]; then
    systemctl restart codex
  else
    echo "[software-update] codex.service absent (runtime not active) — binary updated, no restart"
  fi
  echo "codex updated to $VERSION"
elif [ "$APP" = "claudecode" ]; then
  # Claude Code: re-run Anthropic's installer pinned to $VERSION (positional arg); no .previous backup,
  # the installer keeps old version dirs.
  [ -x /usr/local/bin/claude ] || { echo "claude is not installed on this device — switch the runtime to claudecode first"; exit 1; }
  export HOME=/root
  curl -fsSL https://claude.ai/install.sh | bash -s -- "$VERSION" || { echo "claude installer failed for $VERSION"; exit 1; }
  [ -x /root/.local/bin/claude ] && ln -sf /root/.local/bin/claude /usr/local/bin/claude
  /usr/local/bin/claude --version || { echo "claude not runnable after update"; exit 1; }
  # The unit exists only after switching to the claudecode runtime.
  if [ -f /etc/systemd/system/claudecode.service ]; then
    systemctl restart claudecode
  else
    echo "[software-update] claudecode.service absent (runtime not active) — CLI updated, no restart"
  fi
  echo "claudecode updated to $VERSION"
elif [ "$APP" = "opencode" ]; then
  # OpenCode: official installer, pinned version. OPENCODE_INSTALL_DIR must prefix `bash`, not `curl`.
  [ -x /usr/local/bin/opencode ] || { echo "opencode is not installed on this device — switch the runtime to opencode first"; exit 1; }
  export HOME=/root
  install -D -m 0755 /usr/local/bin/opencode /root/bootstrap/rollback/opencode.previous
  curl -fsSL https://opencode.ai/install | OPENCODE_INSTALL_DIR=/usr/local/bin bash -s -- --version "$VERSION" \
    || { echo "opencode installer failed for $VERSION"; exit 1; }
  # The installer has ignored OPENCODE_INSTALL_DIR before.
  if [ ! -x /usr/local/bin/opencode ]; then
    OC_SRC="$(command -v opencode 2>/dev/null || true)"
    [ -x "$OC_SRC" ] || OC_SRC="/root/.opencode/bin/opencode"
    [ -x "$OC_SRC" ] && install -m 0755 "$OC_SRC" /usr/local/bin/opencode
  fi
  /usr/local/bin/opencode --version || { echo "opencode not runnable after update"; exit 1; }
  # The unit exists only after switching to the opencode runtime.
  if [ -f /etc/systemd/system/opencode.service ]; then
    systemctl restart opencode
  else
    echo "[software-update] opencode.service absent (runtime not active) — CLI updated, no restart"
  fi
  echo "opencode updated to $VERSION"
elif [ "$APP" = "hermes" ]; then
  # Hermes git install. Pinned (hermes.commit): exact checkout, version must match.
  # Unpinned: `hermes update` to HEAD, mismatch only warns (manual path only).
  command -v hermes >/dev/null 2>&1 || { echo "hermes is not installed on this device — switch the runtime to hermes first"; exit 1; }
  export HOME=/root
  HERMES_COMMIT=$(jq -r '.hermes.commit // empty' "$METADATA_PAYLOAD")
  if [ -n "$HERMES_COMMIT" ]; then
    [[ "$HERMES_COMMIT" =~ ^[0-9a-fA-F]{40}$ ]] || { echo "Metadata hermes.commit is not a full 40-char sha: $HERMES_COMMIT"; exit 1; }
    update_hermes_pinned "$HERMES_COMMIT" || { echo "hermes pinned update failed"; exit 1; }
  else
    echo "[software-update] metadata has no hermes.commit — unpinned: hermes update to upstream HEAD"
    update_hermes_package || { echo "hermes update failed"; exit 1; }
  fi
  HERMES_NOW=$(hermes --version 2>/dev/null | cli_semver)
  [ -n "$HERMES_NOW" ] || { echo "hermes not runnable after update"; exit 1; }
  if [ "$HERMES_NOW" != "$VERSION" ]; then
    if [ -n "$HERMES_COMMIT" ]; then
      echo "[software-update] ERROR: hermes landed on $HERMES_NOW, metadata pins $VERSION @ $HERMES_COMMIT — fix the metadata pair (upload-hermes.sh <version> <tag>)"
      exit 1
    fi
    echo "[software-update] WARN: hermes landed on $HERMES_NOW, metadata expected $VERSION (unpinned: upstream HEAD moved)"
  fi
  if [ -f /etc/systemd/system/hermes-gateway.service ]; then
    systemctl restart hermes-gateway
  else
    echo "[software-update] hermes-gateway.service absent (runtime not active) — CLI updated, no restart"
  fi
  # A fresh checkout drops os-server's Hermes source patches; restart os-server to re-apply them.
  if systemctl is-active --quiet os-server; then
    echo "[software-update] restarting os-server to re-apply the Hermes compatibility patches"
    systemctl restart os-server
  fi
  echo "hermes updated to $HERMES_NOW"
elif [ "$APP" = "picoclaw" ]; then
  # PicoClaw: raw binary from our releases. VERSION is the release tag; the binary can't report it,
  # so it is stamped to /usr/local/lib/os-runtimes/picoclaw/installed-version.
  [ -x /usr/local/bin/picoclaw ] || { echo "picoclaw is not installed on this device — switch the runtime to picoclaw first"; exit 1; }
  case "$(uname -m)" in
    aarch64|arm64) PICO_ASSET="picoclaw-linux-arm64" ;;
    x86_64)        PICO_ASSET="picoclaw-linux-amd64" ;;
    *) echo "Unsupported arch $(uname -m) for picoclaw"; exit 1 ;;
  esac
  PICO_URL="https://github.com/autonomous-ai/picoclaw/releases/download/${VERSION}/${PICO_ASSET}"
  DIR_TMP=$(mktemp -d)
  echo "[software-update] downloading $PICO_URL"
  download_verified "$PICO_URL" "$DIR_TMP/$PICO_ASSET" "" || { echo "Failed to download picoclaw $VERSION"; exit 1; }
  # No sha256: run the new binary from the temp dir before replacing the installed one.
  chmod 0755 "$DIR_TMP/$PICO_ASSET"
  "$DIR_TMP/$PICO_ASSET" --no-color version >/dev/null 2>&1 || { echo "Downloaded picoclaw $VERSION is not runnable — keeping the current binary"; exit 1; }
  install -D -m 0755 /usr/local/bin/picoclaw /root/bootstrap/rollback/picoclaw.previous
  install -m 0755 "$DIR_TMP/$PICO_ASSET" /usr/local/bin/picoclaw
  mkdir -p /usr/local/lib/os-runtimes/picoclaw
  echo "$VERSION" > /usr/local/lib/os-runtimes/picoclaw/installed-version
  # The unit exists only after switching to the picoclaw runtime.
  if [ -f /etc/systemd/system/picoclaw.service ]; then
    systemctl restart picoclaw
  else
    echo "[software-update] picoclaw.service absent (runtime not active) — binary updated, no restart"
  fi
  echo "picoclaw updated to $VERSION"
elif [ "$APP" = "web" ]; then
  [ -z "$URL" ] && { echo "Metadata has no url for web"; exit 1; }
  ZIP_TMP=$(mktemp)
  download_verified "$URL" "$ZIP_TMP" "$SHA256" || { echo "Failed checksum verification for web"; exit 1; }
  DIR_TMP=$(mktemp -d "$(dirname "$WEB_ROOT")/.setup.new.XXXXXX")
  unzip -o -q "$ZIP_TMP" -d "$DIR_TMP"
  echo "$VERSION" > "$DIR_TMP/VERSION"
  [ -f "$DIR_TMP/index.html" ] || { echo "No index.html in web zip"; exit 1; }
  save_web_service_state
  arm_service_restore restore_web_service_state
  systemctl stop nginx
  rm -rf "$ROLLBACK_DIR/web.previous"
  mark_publish_pending "$WEB_ROOT" "$ROLLBACK_DIR/web.previous" restore_web_service_state
  mv "$WEB_ROOT" "$ROLLBACK_DIR/web.previous"
  publish_mode "$DIR_TMP" "$ROLLBACK_DIR/web.previous"
  mv "$DIR_TMP" "$WEB_ROOT"
  DIR_TMP=""
  if ! restore_web_service_state || ! check_web; then
    echo "web health check failed; restoring the known-good bundle" >&2
    exit 1
  fi
  clear_publish_pending
  disarm_service_restore
  echo "web updated to $VERSION"
elif [ "$APP" = "hal" ]; then
  [ -z "$URL" ] && { echo "Metadata has no url for hal"; exit 1; }
  ZIP_TMP=$(mktemp)
  download_verified "$URL" "$ZIP_TMP" "$SHA256" || { echo "Failed checksum verification for hal"; exit 1; }
  UV_BIN="$(find_hal_uv)" || exit 1
  HAL_EXTRA="$(hal_dependency_extra)"
  HAL_EXTRA_ARGS=(--extra "$HAL_EXTRA")
  if [ "$HAL_EXTRA" != "reachy" ]; then
    HAL_EXTRA_ARGS+=(--extra pipecat)
  fi
  save_hal_service_state
  arm_service_restore restore_hal_service_state
  systemctl stop hal
  # Recover older interrupted updaters that did not leave a journal.
  if [ ! -d "$HAL_DIR" ] && [ -d "$ROLLBACK_DIR/hal.previous" ]; then
    mv "$ROLLBACK_DIR/hal.previous" "$HAL_DIR"
    sync
  fi
  DIR_TMP=$(mktemp -d "$(dirname "$HAL_DIR")/.hal.new.XXXXXX")
  if [ -d "$HAL_DIR" ]; then
    rm -rf "$ROLLBACK_DIR/hal.previous"
    mark_publish_pending "$HAL_DIR" "$ROLLBACK_DIR/hal.previous" restore_hal_service_state
    if ! mv "$HAL_DIR" "$ROLLBACK_DIR/hal.previous"; then
      restore_hal_service_state || true
      exit 1
    fi
  else
    echo "[software-update] $HAL_DIR is absent — reinstalling from scratch (no rollback point for this run)"
    mark_publish_pending "$HAL_DIR" "$ROLLBACK_DIR/hal.previous" restore_hal_service_state
  fi
  # uv cache lives outside the runtime tree (same filesystem for hardlinks) so updates don't copy it.
  HAL_UV_CACHE="${HAL_UV_CACHE:-$(dirname "$HAL_DIR")/.uv-cache-hal}"
  if [ ! -d "$HAL_UV_CACHE" ] && [ -d "$ROLLBACK_DIR/hal.previous/.uv-cache" ]; then
    echo "[software-update] migrating uv cache out of the runtime tree → $HAL_UV_CACHE"
    mv "$ROLLBACK_DIR/hal.previous/.uv-cache" "$HAL_UV_CACHE" || mkdir -p "$HAL_UV_CACHE"
  fi
  mkdir -p "$HAL_UV_CACHE"
  export UV_CACHE_DIR="$HAL_UV_CACHE" UV_HTTP_TIMEOUT=180
  if ! (
    unzip -o -q "$ZIP_TMP" -d "$DIR_TMP" || exit 1
    if [ -f "$ROLLBACK_DIR/hal.previous/.env" ]; then cp -a "$ROLLBACK_DIR/hal.previous/.env" "$DIR_TMP/.env" || exit 1; fi
    find "$UV_CACHE_DIR" -name "lerobot.egg-info" -type d 2>/dev/null | xargs rm -rf
    cd "$DIR_TMP" || exit 1
    HAL_LOCK_ARGS=()
    [ ! -f uv.lock ] || HAL_LOCK_ARGS+=(--locked)
    "$UV_BIN" sync --python 3.12 --extra hardware "${HAL_EXTRA_ARGS[@]}" "${HAL_LOCK_ARGS[@]}" || exit 1
  ); then
    echo "HAL staging failed; restoring known-good runtime" >&2
    cd /
    exit 1
  fi
  cd /
  publish_mode "$DIR_TMP" "$ROLLBACK_DIR/hal.previous"
  HAL_STAGED="$DIR_TMP"
  if ! mv "$DIR_TMP" "$HAL_DIR"; then
    echo "HAL activation failed; restoring known-good runtime" >&2
    exit 1
  fi
  DIR_TMP=""
  relocate_venv_scripts "$HAL_DIR/.venv" "$HAL_STAGED" "$HAL_DIR"
  if ! restore_hal_service_state || ! check_hal; then
    echo "HAL health check failed; restoring the known-good runtime" >&2
    exit 1
  fi
  clear_publish_pending
  disarm_service_restore
  echo "hal updated to $VERSION"
elif [ "$APP" = "claude-desktop-buddy" ]; then
  [ -z "$URL" ] && { echo "Metadata has no url for claude-desktop-buddy"; exit 1; }
  ZIP_TMP=$(mktemp)
  DIR_TMP=$(mktemp -d)
  download_verified "$URL" "$ZIP_TMP" "$SHA256" || { echo "Failed checksum verification for claude-desktop-buddy"; exit 1; }
  BUDDY_DIR="/opt/claude-desktop-buddy"
  mkdir -p "$BUDDY_DIR"
  unzip -o -q "$ZIP_TMP" -d "$DIR_TMP"
  [ -f "$DIR_TMP/buddy-plugin" ] && cp -f "$DIR_TMP/buddy-plugin" "$BUDDY_DIR/buddy-plugin" && chmod +x "$BUDDY_DIR/buddy-plugin"
  [ ! -f "/root/config/buddy.json" ] && [ -f "$DIR_TMP/config/buddy.json" ] && mkdir -p /root/config && cp -f "$DIR_TMP/config/buddy.json" /root/config/buddy.json
  echo "$VERSION" > "$BUDDY_DIR/VERSION_BUDDY"
  systemctl restart claude-desktop-buddy
  echo "claude-desktop-buddy updated to $VERSION"
elif [ "$APP" = "device" ]; then
  [ -z "$URL" ] && { echo "Metadata has no url for devices.$DEVICE_TYPE"; exit 1; }
  resolve_device_profile || exit 1
  DEST="$DEVICE_DEST"
  ZIP_TMP=$(mktemp)
  download_verified "$URL" "$ZIP_TMP" "$SHA256" || { echo "Failed checksum verification for device profile"; exit 1; }
  mkdir -p "$DEVICES_DIR"
  DIR_TMP=$(mktemp -d "$DEVICES_DIR/.${DEVICE_TYPE}.new.XXXXXX")
  unzip -o -q "$ZIP_TMP" -d "$DIR_TMP"
  [ -f "$DIR_TMP/ROBOT.md" ] || { echo "No ROBOT.md in device profile"; exit 1; }
  [ -d "$DEST" ] || { echo "No installed device profile at $DEST"; exit 1; }
  HARDWARE_PROFILE=""
  [ ! -e /etc/autonomous/hardware-profile ] || HARDWARE_PROFILE=$(sed 's/^[[:space:]]*//;s/[[:space:]]*$//' /etc/autonomous/hardware-profile) \
    || { echo "Cannot read hardware profile selection" >&2; exit 1; }
  if [ -n "$HARDWARE_PROFILE" ] && [ "$HARDWARE_PROFILE" != standard ]; then
    [ -f "$DIR_TMP/apply-overrides.py" ] \
      || { echo "Hardware overrides require an override-capable device package" >&2; exit 1; }
    python3 "$DIR_TMP/apply-overrides.py" --profile "$DIR_TMP" --root / \
      || { echo "Hardware override configuration failed; installed profile unchanged" >&2; exit 1; }
  fi
  save_device_service_state
  arm_service_restore restore_device_service_state
  systemctl stop os-server
  systemctl stop hal
  DEVICE_ROOTFS_SNAPSHOT=$(mktemp -d "$ROLLBACK_DIR/.device.rootfs.new.XXXXXX")
  snapshot_device_rootfs "$DEST/rootfs" "$DIR_TMP/rootfs" "$DEVICE_ROOTFS_SNAPSHOT"
  rm -rf "$ROLLBACK_DIR/device.previous"
  mark_publish_pending "$DEST" "$ROLLBACK_DIR/device.previous" restore_device_service_state
  mv "$DEST" "$ROLLBACK_DIR/device.previous"
  publish_mode "$DIR_TMP" "$ROLLBACK_DIR/device.previous"
  mv "$DIR_TMP" "$DEST"
  DIR_TMP=""
  # Apply the profile rootfs overlay including /opt/hal/.env; the repo is the source of truth,
  # so on-device .env edits are intentionally overwritten. Do not re-add a backup.
  if ! { [ ! -d "$DEST/rootfs" ] || cp -a "$DEST/rootfs/." /; } \
      || ! systemctl daemon-reload \
      || ! restore_device_service_state || ! check_device_profile; then
    echo "device profile apply or health check failed; restoring the known-good profile" >&2
    exit 1
  fi
  # Keep the journal's snapshot intact until commit, even while replacing the
  # separate snapshot used by a later manual rollback.
  ROOTFS_PUBLISH=$(mktemp -d "$ROLLBACK_DIR/.device.rootfs.publish.XXXXXX")
  cp -a "$DEVICE_ROOTFS_SNAPSHOT/." "$ROOTFS_PUBLISH/"
  rm -rf "$ROLLBACK_DIR/device.previous.rootfs"
  mv "$ROOTFS_PUBLISH" "$ROLLBACK_DIR/device.previous.rootfs"
  clear_publish_pending
  disarm_service_restore
  rm -rf "$DEVICE_ROOTFS_SNAPSHOT"
  echo "device profile ($DEVICE_TYPE) updated to $VERSION"
fi
